# ─────────────────────────────────────────────
# SMTP email sender (Gmail) — copy to .env and fill in
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com

# 16-char Google App Password: https://myaccount.google.com/apppasswords
SMTP_PASS=

SMTP_FROM_NAME=Portfolio Contact
SMTP_FROM_EMAIL=your-address@gmail.com
CONTACT_TO_EMAIL=your-address@gmail.com
